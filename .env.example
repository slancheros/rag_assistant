# Docker Compose runs Ollama by default. Override these values
# only when you want different local models or tuning.
APP_PORT=8000
# Required. Generate with: openssl rand -hex 32
API_ACCESS_KEY=

LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=embeddinggemma

RELEVANCE_THRESHOLD=0.35
TOP_K=2
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=256

PROVIDER_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO
